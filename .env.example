# Copy to .env and adjust. .env is gitignored.

# --- docker-compose (db service) ---
POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel_dev_pw
POSTGRES_DB=hotel_advdb
POSTGRES_PORT=5433

# --- Next.js server + db scripts ---
DATABASE_URL=postgres://hotel:hotel_dev_pw@localhost:5433/hotel_advdb

# JWT signing key for the staff session cookie (>= 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string
